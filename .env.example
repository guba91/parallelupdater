# Copy to .env and edit. .env is in .gitignore.
#
# Hosts are read from the ssh config in SSH_DIR: every "Host" alias (wildcards skipped)
# is a host to update. Set users, keys, ports, ProxyJump... there.

# Directory with ssh config + private keys, mounted read-only
SSH_DIR=~/.ssh

# Optional: aliases from the ssh config that must never be updated, space separated
#EXCLUDE="myworkstation printer"

# Optional: minutes before "apt update" is run again automatically
#APT_UPDATE_MAX_AGE=60

# Optional: ssh connect timeout (seconds)
#CONNECT_TIMEOUT=5

# Optional: command run on the host you choose
#UPGRADE_CMD=apt-get upgrade -y
