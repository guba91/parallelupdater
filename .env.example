# Copy to .env and edit. .env is in .gitignore.

# Hosts to update, separated by spaces or newlines.
#   name      -> resolved through your ssh config (HostName, User, IdentityFile...)
#   name=ip   -> added to the container's /etc/hosts
HOSTS="
webserver
database
testlxc=192.168.5.11
"

# Directory with ssh config + private key, mounted read-only (default ~/.ssh)
#SSH_DIR=~/.ssh

# Minutes before "apt update" is run again automatically
#APT_UPDATE_MAX_AGE=60

# ssh connect timeout (seconds)
#CONNECT_TIMEOUT=5

# Command run on the host you choose
#UPGRADE_CMD=apt-get upgrade -y
