#!/bin/bash
cat /root/my_hosts >> /etc/hosts
mkdir -p ./ggupdate
touch ./ggupdate/aggiornamenti.txt
touch ./ggupdate/aggiornabili.txt


cat /root/my_hosts | awk '{print $2}' | sed -e '1,7d' > ./ggupdate/hosts_name
while read arg; do ssh-keyscan -H $arg >> ~/.ssh/known_hosts; done < ./ggupdate/hosts_name
    
#let's find out if it was a rerun or a new run
if [[ $1 != "again" ]]; then
  if [[ ! -e ./ggupdate/whenupdated || $(find ./ggupdate/whenupdated -mmin +60 -print) ]]; then
    # echo "last update not in an hour, let me update everything"
    #whiptail --title "Updating" --infobox "Please wait, apt update of every host." 8 78
    # send apt update on every hosts in "hosts_name"
    {
    parallel-ssh -h ./ggupdate/hosts_name "apt update > /dev/null 2>&1" > /dev/null 2>&1
    } | whiptail --title "Updating" --gauge "Please wait, apt update of every host." 8 78 0
    
    # touch the file to know when this happened
    touch ./ggupdate/whenupdated
  else
    # last update less than 1 hour ago
    if (whiptail --title "Updating" --yesno "No apt update needed, last in the previous hour.\nDo it anyway?" 20 120 --scrolltext 3>&1 1>&2 2>&3); then
      whiptail --title "Updating" --infobox "Please wait, apt update of every host." 8 78
      {
        parallel-ssh -h ./ggupdate/hosts_name "apt update > /dev/null 2>&1" > /dev/null 2>&1
      } | whiptail --title "Updating" --gauge "Please wait, apt update of every host." 8 78 0
      touch ./ggupdate/whenupdated
    fi
  fi
fi




{
unbuffer parallel-ssh --inline-stdout -h ./ggupdate/hosts_name "apt list --upgradable | grep -e SUCCESS -e upgradable" | grep -e SUCCESS -e upgradable --color=auto > ./ggupdate/aggiornamenti.txt
} | whiptail --title "Updating List" --gauge "Please wait, refreshing list" 8 78 0


#whiptail --title "Updating list" --infobox "Please wait, creating upgradable hosts list" 8 78

# creating the list of the hosts that can be update
# create file aggiornabili.txt with the list of the servers that can be update

cat ./ggupdate/aggiornamenti.txt | grep SUCCESS --color=auto | awk '{print $NF}' > ./ggupdate/aggiornabili.txt

whiptail --title "Updating list" --infobox "Please wait, creating array" 8 78
# creating array with servers that can be update

arr=()
while IFS= read -r line; do
   arr+=("$line")
   arr+=("")
done <./ggupdate/aggiornabili.txt

if [ -s ./ggupdate/aggiornabili.txt ]; then
  # The file is not-empty, so there is at least 1 host to update

  #select a host to update
  thathost=$(whiptail --title "What to update" --menu "Choose an option" 25 78 16 "${arr[@]}" 3>&1 1>&2 2>&3)

  if ! [ -z "${thathost}" ]; then #if thathost is selected
    # create the list of packages to be updated for the selected hosts
    mapfile -t my_array < <( parallel-ssh --inline-stdout -H $thathost "apt list --upgradable | grep upgradable" )

    # remove the first line that contain the hostname of the selected hosts
    my_array=("${my_array[@]:1}")

    # create a string with CR from the array
    list=$( IFS=$'\n'; echo "${my_array[*]}" )

    if (whiptail --title "Available Update" --yesno "$list" 20 120 --scrolltext 3>&1 1>&2 2>&3); then
      ssh -t root@${thathost} screen 'apt upgrade -y'
    fi
  fi
  if (whiptail --title "What now?" --yesno "Star Over?" 20 120 --scrolltext 3>&1 1>&2 2>&3); then
    bash parallelupdater again
  fi

else
  # The file is empty so there is no update to do
  whiptail --title "The End" --msgbox "No update available" 12 80
fi

clear
