#!/bin/bash
# parallelupdater - apt update/upgrade many Debian/Ubuntu hosts via parallel-ssh + whiptail
#
# Hosts come from the ssh config mounted at /root/.ssh (every concrete "Host" alias,
# Include files followed, wildcard patterns skipped). Users, keys, ports, ProxyJump...
# are all taken from there.
#
# Optional environment variables (see .env.example):
#   EXCLUDE               aliases never to update, space separated
#   APT_UPDATE_MAX_AGE    minutes before a new "apt update" is run automatically (default 60)
#   CONNECT_TIMEOUT       ssh connect timeout in seconds (default 5)
#   UPGRADE_CMD           command run on the chosen host (default "apt-get upgrade -y")
# Persistent state lives in /data.

STATE=${STATE:-/data}
SSH_DIR=/root/.ssh
APT_UPDATE_MAX_AGE=${APT_UPDATE_MAX_AGE:-60}
CONNECT_TIMEOUT=${CONNECT_TIMEOUT:-5}
UPGRADE_CMD=${UPGRADE_CMD:-apt-get upgrade -y}
HOSTFILE="$STATE/hosts_name"
SSHCFG="$STATE/ssh_config"
OUT="$STATE/out"
mkdir -p "$STATE"

if [[ ! -r $SSH_DIR/config ]]; then
  echo "No ssh config found at $SSH_DIR/config (check SSH_DIR in .env)" >&2; exit 1
fi

# print every concrete Host alias of an ssh config file, following Include
parse_config() {
  local kw rest h p g
  while read -r kw rest; do
    case ${kw,,} in
      host)
        set -f
        for h in $rest; do [[ $h == *[*?!]* ]] || echo "$h"; done
        set +f ;;
      include)
        for p in $rest; do
          p=${p/#\~/\/root}
          [[ $p == /* ]] || p=$SSH_DIR/$p
          for g in $p; do [[ -f $g ]] && parse_config "$g"; done
        done ;;
    esac
  done < <(sed -e 's/#.*//' -e 's/=/ /' "$1")
}

# parallel-ssh lowercases host names, while ssh config "Host" matching is case-sensitive:
# for mixed-case aliases we write a lowercase alias with the same effective settings.
: > "$SSHCFG"
declare -A seen
excl=" ${EXCLUDE,,} "
for alias in $(parse_config "$SSH_DIR/config"); do
  lc=${alias,,}
  [[ $excl == *" $lc "* ]] && continue
  eff=$(ssh -G "$alias" 2>/dev/null) || continue
  key=$(awk '$1=="user"{u=$2} $1=="hostname"{h=$2} $1=="port"{p=$2} END{print u"@"h":"p}' <<<"$eff")
  [[ -n ${seen[$key]} ]] && continue          # same machine under another alias
  seen[$key]=1
  if [[ $alias != "$lc" ]]; then
    echo "Host $lc"
    awk '$1~/^(hostname|user|port|identityfile|proxyjump|identitiesonly)$/ && $2!="none" {print "  "$0}' <<<"$eff"
  fi >> "$SSHCFG"
  echo "$lc"
done > "$HOSTFILE"
printf 'Match all\nInclude %s/config\n' "$SSH_DIR" >> "$SSHCFG"

if [[ ! -s $HOSTFILE ]]; then
  echo "No hosts found in $SSH_DIR/config" >&2; exit 1
fi

SSH_OPTS=(-F "$SSHCFG" -o BatchMode=yes -o "ConnectTimeout=$CONNECT_TIMEOUT"
          -o StrictHostKeyChecking=accept-new
          -o "UserKnownHostsFile=$STATE/known_hosts $SSH_DIR/known_hosts")
PSSH_OPTS=(-x "-F $SSHCFG")
for o in "${SSH_OPTS[@]:2}"; do [[ $o == -o ]] || PSSH_OPTS+=(-O "$o"); done

run_apt_update() {
  whiptail --title "Updating" --infobox "apt update on $(wc -l < "$HOSTFILE") hosts, please wait..." 8 78
  parallel-ssh -t 300 "${PSSH_OPTS[@]}" -h "$HOSTFILE" "apt-get update -qq >/dev/null 2>&1" >/dev/null 2>&1
  touch "$STATE/whenupdated"
}

if [[ $1 != "again" ]]; then
  if [[ ! -e $STATE/whenupdated || -n $(find "$STATE/whenupdated" -mmin +"$APT_UPDATE_MAX_AGE") ]]; then
    run_apt_update
  elif whiptail --title "Updating" --yesno "Last apt update less than $APT_UPDATE_MAX_AGE minutes ago.\nDo it anyway?" 10 60; then
    run_apt_update
  fi
fi

whiptail --title "Updating list" --infobox "Collecting upgradable packages..." 8 78
rm -rf "$OUT"; mkdir -p "$OUT"
# remote always exits 0 when reachable, so FAILURE == unreachable / auth problem
parallel-ssh -t 60 "${PSSH_OPTS[@]}" -h "$HOSTFILE" -o "$OUT" \
  "apt list --upgradable 2>/dev/null | grep upgradable || true" > "$STATE/pssh.log" 2>&1

unreachable=$(grep FAILURE "$STATE/pssh.log" | sed 's/\x1b\[[0-9;]*m//g' | awk '{print $4}' | sort -u)

arr=()
while read -r h; do
  n=$(grep -c upgradable "$OUT/$h" 2>/dev/null)
  [[ ${n:-0} -gt 0 ]] && arr+=("$h" "$n packages")
done < "$HOSTFILE"

if [[ -n $unreachable ]]; then
  whiptail --title "Unreachable hosts" --msgbox "These hosts did not answer (down, DNS, or host key).\nAdd them to EXCLUDE in .env or remove them from your ssh config:\n\n$(echo "$unreachable" | tr '\n' ' ')" 16 80
fi

if [[ ${#arr[@]} -eq 0 ]]; then
  whiptail --title "The End" --msgbox "No update available" 10 60
  clear; exit 0
fi

thathost=$(whiptail --title "What to update" --menu "Choose a host" 25 78 16 "${arr[@]}" 3>&1 1>&2 2>&3)

if [[ -n $thathost ]]; then
  list=$(cut -d' ' -f1-2 "$OUT/$thathost")
  if whiptail --title "Available updates on $thathost" --yesno "$list" 25 120 --scrolltext; then
    clear
    # run inside screen if available so a dropped connection doesn't kill the upgrade
    ssh -t "${SSH_OPTS[@]}" "$thathost" \
      "if command -v screen >/dev/null; then screen $UPGRADE_CMD; else $UPGRADE_CMD; fi"
    read -rp "Press Enter to continue..."
  fi
fi

if whiptail --title "What now?" --yesno "Start over?" 10 60; then
  exec bash "$0" again
fi
clear
